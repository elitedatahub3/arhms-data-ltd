# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Paystack
# Backs TWO different integrations off the one secret key:
#   1. Hosted checkout (transaction/initialize -> authorization_url) for web and
#      storefront flows, selectable per scope in /admin/settings.
#   2. Mobile Money Charge API for USSD sales (lib/paystack-momo-service.ts).
#      USSD callers have no browser to redirect, so they are debited directly and
#      approve on the handset. Requires Mobile Money to be enabled on a
#      Ghana-registered Paystack business with GHS settlement.
PAYSTACK_SECRET_KEY=your_paystack_secret_key
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=your_paystack_public_key

# CodeCraft API (for AT-iShare, Telecel, AT-BigTime)
CODECRAFT_API_URL=https://api.codecraftnetwork.com/api
CODECRAFT_API_KEY=your_codecraft_api_key

# Eazy Data API (for MTN, Telecel, AT)
EAZYDATA_API_KEY=your_eazydata_api_key_here

# Agent Portal GH (for MTN, Telecel, AT — queue-based, webhook completion).
# Also backs the MTN registration check: without AGENTPORTAL_API_KEY the
# pre-purchase registration gate fails open and orders are never blocked.
AGENTPORTAL_API_URL=https://api.agentportalgh.com
AGENTPORTAL_API_KEY=your_agentportal_api_key_here
AGENTPORTAL_WEBHOOK_SECRET=your_agentportal_webhook_secret_here

# HendyLinks (for MTN, Telecel, AT — webhook completion + polling fallback).
# The webhook secret defaults to HENDYLINKS_API_KEY, which is what their docs
# sign with; set it only if they ever issue a separate signing secret.
HENDYLINKS_API_URL=https://hendylinks.net
HENDYLINKS_API_KEY=your_hendylinks_api_key_here
# HENDYLINKS_WEBHOOK_SECRET=

# KingFlexy API (for MTN, Telecel, AT)
KINGFLEXY_API_URL=your_kingflexy_api_url_here
KINGFLEXY_API_KEY=your_kingflexy_api_key_here
# Commission Services key (kf_cs_live_) — used for utility bill payments
# (lib/kingflexy-utility-service.ts) AND Airtime v2 purchases
# (lib/kingflexy-airtime-service.ts). NOT the standard KINGFLEXY_API_KEY above,
# which is for the v1 data endpoints only.
KINGFLEXY_COMMISSION_KEY=your_kingflexy_commission_key_here
# Airtime v2 base URL. Defaults to https://api.kingflexygh.com/api/v2 in code if unset.
# Authenticates with KINGFLEXY_COMMISSION_KEY above.
KINGFLEXY_API_V2_URL=https://api.kingflexygh.com/api/v2

# NetPulse API (for MTN, Telecel, AT — polling completion, no webhook)
NETPULSE_API_URL=https://netpluse.shop/api/v1
NETPULSE_API_KEY=your_netpulse_api_key_here

# DataKazina API Configuration
DATAKAZINA_API_KEY=your_datakazina_api_key_here
DATAKAZINA_API_BASE_URL=https://reseller.dakazinabusinessconsult.com/api/v1

# Auto-Fulfillment Toggle (set to 'false' to disable auto-fulfillment)
# When disabled, orders stay as 'pending' for manual processing
ENABLE_AUTO_FULFILLMENT=true

# Moolre & Hubtel SMS
MOOLRE_API_KEY=your_moolre_api_key
MOOLRE_SENDER_ID=ARHMS
HUBTEL_SMS_SENDER_ID=ArhmsTech
HUBTEL_SMS_CLIENT_ID=Gyfwgjjy
HUBTEL_SMS_CLIENT_SECRET=your_hubtel_sms_client_secret
SMS_ENABLED=true

# Moolre Transfer API (for automated shop withdrawals — separate from SMS)
# Get these from your Moolre dashboard: https://app.moolre.com
MOOLRE_TRANSFER_API_USER=your_moolre_username
MOOLRE_TRANSFER_API_KEY=your_moolre_transfer_api_key
MOOLRE_ACCOUNT_NUMBER=your_moolre_account_number

# Hubtel Direct Receive Money (collections)
HUBTEL_CLIENT_ID=your_hubtel_api_id
HUBTEL_CLIENT_SECRET=your_hubtel_api_key
HUBTEL_COLLECTION_ACCOUNT_NUMBER=your_hubtel_merchant_account
HUBTEL_FEE_PERCENT=1.8

# Hubtel Commission Services (airtime top-ups AND utility bills: DSTV, GOtv,
# StarTimes, ECG, Ghana Water). This is the DISBURSEMENT account — a different
# number from HUBTEL_COLLECTION_ACCOUNT_NUMBER — and it must be funded or every
# top-up and bill payment fails. Each utility service also has to be provisioned
# on this account by Hubtel; an unprovisioned service ID just returns a rejection.
# The FIXIE_URL static IP below must be whitelisted for THIS account too, not only
# the collection one.
HUBTEL_PREPAID_ACCOUNT_NUMBER=your_hubtel_prepaid_account
# Optional — most merchants use one API key for collections and commission
# services, in which case leave these unset and HUBTEL_CLIENT_ID/SECRET are used.
HUBTEL_AIRTIME_CLIENT_ID=
HUBTEL_AIRTIME_CLIENT_SECRET=

# PaySwitch / TheTeller (mobile money collections)
# https://prod.theteller.net for live, https://test.theteller.net for sandbox.
PAYSWITCH_MERCHANT_ID=your_payswitch_merchant_id
PAYSWITCH_API_USER=your_payswitch_api_username
PAYSWITCH_API_KEY=your_payswitch_api_key
PAYSWITCH_BASE_URL=https://prod.theteller.net
# AirtelTigo r-switch code. TheTeller documents both ATL (Airtel) and TGO (Tigo)
# from before the merger; set this if ATL is rejected for your merchant account.
PAYSWITCH_AT_SWITCH=ATL
# PaySwitch goes out DIRECT by default. Only set this if PaySwitch requires a
# whitelisted IP — Fixie is metered, and exhausting it once already took Hubtel
# payments down with a 407. If you do enable it, whitelist Fixie's whole egress
# pool with PaySwitch: it hands out a different IP per request.
PAYSWITCH_USE_PROXY=false
# Callback to configure in the PaySwitch dashboard:
#   ${NEXT_PUBLIC_APP_URL}/api/webhooks/payswitch
# Use the www. host — the callback does not follow redirects.

# Static outbound proxy, required by gateways that whitelist our IP (Hubtel today).
# Vercel has no fixed egress IP. Get a URL + static IP at https://usefixie.com and
# whitelist that IP in the gateway's merchant portal.
FIXIE_URL=http://user:pass@criterium.usefixie.com:80

# Feature Flags
NEXT_PUBLIC_PAYMENT_MAINTENANCE_MODE=false

# USSD UAT mode: while true, the USSD flow charges USSD_UAT_AMOUNT (default
# 0.01) instead of the real checker price and skips the underpayment guard,
# so Hubtel UAT can be run at a tiny amount against the real menu/prices.
# MUST be false or unset in production.
USSD_UAT_MODE=false
USSD_UAT_AMOUNT=0.01

# App
# Use the host that serves the app directly (200), not one that redirects —
# Hubtel/Paystack callbacks do not follow redirects.
NEXT_PUBLIC_APP_URL=https://www.arhmsgh.com
NEXT_PUBLIC_MARKETPLACE_URL=https://marketplace.arhmsgh.com
CRON_SECRET=your_cron_secret
CRON_JOBS_ENABLED=false

# Upstash Redis (Rate Limiting)
UPSTASH_REDIS_REST_URL="your-upstash-redis-rest-url-here"
UPSTASH_REDIS_REST_TOKEN="your-upstash-redis-rest-token-here"
